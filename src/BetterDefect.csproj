<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
  <Import Project=".\Sts2PathDiscovery.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BetterDefect</RootNamespace>
    <AssemblyName>BetterDefect</AssemblyName>
    <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
    <PathMap>$(AppOutputBase)=.\</PathMap>
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Sts2TargetVersion)' == 'v110'">
    <DefineConstants>$(DefineConstants);STS2_V110</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Sts2TargetVersion)' == 'v111'">
    <DefineConstants>$(DefineConstants);STS2_V110;STS2_V111</DefineConstants>
    <RitsuLibRuntimePath Condition="'$(RitsuLibRuntimePath)' == ''">$(Sts2Path)/mods/STS2-RitsuLib/compat/0.111.0/STS2-RitsuLib.Runtime.dll</RitsuLibRuntimePath>
  </PropertyGroup>
  <PropertyGroup>
    <BetterDefectManifest>BetterDefect.json</BetterDefectManifest>
    <BetterDefectManifest Condition="'$(Sts2TargetVersion)' == 'v111'">BetterDefect-v111.json</BetterDefectManifest>
  </PropertyGroup>

  <!-- PC v107.1 already uses the modern side-turn hook even though its public
       version number predates Android v110. Keep that ABI distinction separate
       from the other v110-only APIs. -->
  <PropertyGroup Condition="'$(Sts2TargetVersion)' == ''">
    <DefineConstants>$(DefineConstants);STS2_PC_MODERN</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(Sts2DataDir)')">
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Sts2TargetVersion)' == 'v111'">
    <Reference Include="STS2-RitsuLib.Runtime"><HintPath>$(RitsuLibRuntimePath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BetterDefectCode\**\*.cs" />
    <None Include="BetterDefect.json" />
    <None Include="BetterDefect-v111.json" />
    <None Include="project.godot" />
    <BetterDefectPortrait Include="BetterDefectData\Portraits\*.png" />
  </ItemGroup>

  <Target Name="CheckDependencyPaths">
    <Error Text="Slay the Spire 2 data not found at path '$(Sts2DataDir)'." Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    <Error Text="v111 build requires STS2-RitsuLib.Runtime.dll at '$(RitsuLibRuntimePath)'." Condition="'$(Sts2TargetVersion)' == 'v111' and !Exists('$(RitsuLibRuntimePath)')" />
  </Target>

  <Target Name="CopyToModsFolderOnBuild" AfterTargets="Build" Condition="Exists('$(Sts2Path)')">
    <Message Text="Copying BetterDefect.dll, .pdb, manifest and portraits to $(ModsPath)BetterDefect/" Importance="high" />
    <MakeDir Directories="$(ModsPath)BetterDefect/" />
    <MakeDir Directories="$(ModsPath)BetterDefect/Data/Portraits/" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)BetterDefect/" />
    <Copy SourceFiles="$(BetterDefectManifest)" DestinationFiles="$(ModsPath)BetterDefect/BetterDefect.json" />
    <Copy SourceFiles="@(BetterDefectPortrait)" DestinationFolder="$(ModsPath)BetterDefect/Data/Portraits/" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsPath)BetterDefect/" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>

